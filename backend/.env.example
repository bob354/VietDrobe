# Việt Phục Remix Configuration
DEBUG=True
DATABASE_URL=sqlite+aiosqlite:///./data/vietphuc.db
STORAGE_PATH=./data

# ==========================================
# AI Provider Configuration (OpenAI or Groq/Grok)
# ==========================================

# Option A: Groq (high quota: openai/gpt-oss-120b or qwen/qwen3.8-27b)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-api-key-here
AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai/v1  (automatically configured when AI_PROVIDER=groq)

# Option B: OpenAI (using GPT-4o-mini)
# AI_PROVIDER=openai
# AI_API_KEY=your-openai-api-key-here
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# Option C: OpenRouter (supports Qwen 2.5 7B, Llama 3.1 8B, Gemini, etc.)
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# AI_MODEL=qwen/qwen-2.5-7b-instruct
# AI_BASE_URL=https://openrouter.ai/api/v1
